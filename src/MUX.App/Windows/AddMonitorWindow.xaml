<Window x:Class="MUX.App.Windows.AddMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add monitor" Width="438" Height="458"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F7080B0F"
            BorderBrush="#27323D"
            BorderThickness="1"
            CornerRadius="18"
            Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="34" Opacity="0.52" ShadowDepth="10" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="NEW MONITOR"
                           Foreground="{StaticResource SubtleBrush}"
                           FontSize="8"
                           FontWeight="SemiBold" />
                <TextBlock Text="Create physical space"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                <TextBlock Text="Define the real-world monitor size. MUX handles the pixel geometry."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,25,0,0">
                <TextBlock Text="Name"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="2,0,0,6" />
                <TextBox x:Name="NameBox" Style="{StaticResource MuxTextBox}" Text="Monitor" />

                <TextBlock Text="Physical diagonal"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="2,17,0,6" />
                <Grid>
                    <TextBox x:Name="SizeBox"
                             Style="{StaticResource MuxTextBox}"
                             Text="27"
                             Padding="11,9,42,9" />
                    <TextBlock Text="in"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,13,0"
                               FontSize="10" />
                </Grid>

                <TextBlock Text="Aspect ratio"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="2,17,0,6" />
                <ComboBox x:Name="AspectBox"
                          Style="{StaticResource MuxComboBox}"
                          SelectedIndex="0">
                    <ComboBoxItem Content="16:9" />
                    <ComboBoxItem Content="16:10" />
                    <ComboBoxItem Content="21:9" />
                    <ComboBoxItem Content="32:9" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="3:2" />
                </ComboBox>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="10"
                           Margin="2,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Cancel"
                        Style="{StaticResource MuxQuietButton}"
                        Click="Cancel_Click" />
                <Button Grid.Column="2"
                        Content="Create monitor"
                        Style="{StaticResource MuxPrimaryButton}"
                        Click="Create_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
