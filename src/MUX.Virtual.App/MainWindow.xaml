<Window x:Class="MUX.Virtual.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MUX Virtual Displays"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0E0F12"
        Foreground="#F2F3F5"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MUX"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#AEB3BC"/>
                <TextBlock Text="Virtual Displays"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Margin="0,5,0,4"/>
                <TextBlock Text="True Windows monitors, composited into your physical MUX layout."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#15171B"
                    BorderBrush="#292C31"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             Fill="#737985"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Stopped"
                               VerticalAlignment="Center"
                               Foreground="#CDD1D7"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Layout"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,7"/>
                    <ComboBox x:Name="LayoutPicker"
                              Width="380"
                              HorizontalAlignment="Left"
                              SelectionChanged="LayoutPicker_SelectionChanged"/>
                    <TextBlock x:Name="LayoutMeta"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button x:Name="ReloadButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Reload layouts"
                            Margin="0,0,10,0"
                            Click="ReloadButton_Click"/>
                    <Button x:Name="DisplaySettingsButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Windows display settings"
                            Click="DisplaySettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Windows monitor plan"
                                   FontWeight="SemiBold"
                                   FontSize="15"/>
                        <TextBlock Text="Each row below becomes a real monitor reported by Windows."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="CTRL + ALT + ESC releases the cursor"
                               Foreground="#AEB3BC"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Grid>

                <ListBox x:Name="MonitorList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F2F3F5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#111318"
                                    BorderBrush="#24272D"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <Grid Width="760">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ZoneId}"
                                                   Foreground="#737985"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Resolution}"
                                               Foreground="#D3D6DB"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding HostPosition}"
                                               Foreground="#8E949E"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="DriverText"
                           Text="Driver status not checked."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"/>
                <TextBlock Text="The Standard MUX download remains unchanged. This edition shares the same saved layouts."
                           Foreground="#686E78"
                           FontSize="11"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="InstallDriverButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Install driver"
                        Margin="0,0,10,0"
                        Click="InstallDriverButton_Click"/>
                <Button x:Name="StopButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Stop"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="StopButton_Click"/>
                <Button x:Name="ActivateButton"
                        Content="Activate virtual displays"
                        Click="ActivateButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
