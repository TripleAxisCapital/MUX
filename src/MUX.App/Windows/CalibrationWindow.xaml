<Window x:Class="MUX.App.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Background="#F20A0A0B"
        ShowInTaskbar="False" Topmost="True">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
            <TextBlock Text="Calibrate MUX" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Measure the line below with a real ruler or tape measure." FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <Canvas x:Name="LineCanvas" Grid.Row="1" Margin="60,0" ClipToBounds="False">
            <Border x:Name="MeasureLine" Height="2" Background="White" />
            <Border x:Name="LeftTick" Width="2" Height="24" Background="White" />
            <Border x:Name="RightTick" Width="2" Height="24" Background="White" />
        </Canvas>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Width="720">
            <TextBlock Text="This line should measure exactly 10.00 inches" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            <StackPanel Margin="0,34,0,0" Width="320">
                <TextBlock Text="What does it actually measure?" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,7" />
                <Grid>
                    <TextBox x:Name="MeasuredBox" Text="10.00" Style="{StaticResource MuxTextBox}" Padding="11,9,42,9" />
                    <TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                </Grid>
                <TextBlock x:Name="ErrorText" Foreground="#FF7A7A" FontSize="12" Margin="2,9,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Cancel" Width="130" Style="{StaticResource MuxButton}" Click="Cancel_Click" />
                <Button Content="Reset" Width="130" Margin="12,0,0,0" Style="{StaticResource MuxButton}" Click="Reset_Click" />
                <Button Content="Calibrate" Width="150" Margin="12,0,0,0" Style="{StaticResource MuxPrimaryButton}" Click="Calibrate_Click" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Esc to cancel" Foreground="#66666E" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" />
    </Grid>
</Window>
