<Window x:Class="MUX.App.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Icon="pack://application:,,,/Assets/mux-logo.png"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0A0A0A" ShowInTaskbar="False" Topmost="True">
    <Grid Background="#0A0A0A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Canvas Grid.Column="0" x:Name="ReferenceCanvas"
                Background="#0D0D0D" ClipToBounds="True" Margin="18">
            <Border x:Name="ReferenceFrame"
                    Background="#130D0D0D"
                    BorderBrush="#F2F2F2" BorderThickness="2"
                    CornerRadius="0" SnapsToDevicePixels="True"
                    IsHitTestVisible="False" Width="400" Height="225">
                <Grid ClipToBounds="True">
                    <Line x:Name="DiagonalLine" Stroke="#626262" StrokeThickness="1"
                          StrokeDashArray="3 6" SnapsToDevicePixels="True"
                          IsHitTestVisible="False"/>
                    <Border Background="#EDEDED" CornerRadius="4" Padding="14,9"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="FrameLabel" Text="10-INCH REFERENCE"
                                       Foreground="#111111" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FrameSubLabel" Text="16:9 • Outer-corner diagonal"
                                       Foreground="#4D4D4D" FontSize="10" Margin="0,5,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <primitives:Thumb x:Name="ResizeHandle" Width="34" Height="34"
                              Cursor="SizeNWSE" DragDelta="ResizeHandle_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="#FFFFFF" BorderBrush="#222222"
                                BorderThickness="2" CornerRadius="6">
                            <TextBlock Text="↘" Foreground="#161616" FontSize="18"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Canvas>

        <Border Grid.Column="1" Background="#141414" BorderBrush="#333333"
                BorderThickness="1,0,0,0" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MUX / CALIBRATION" Foreground="#989898"
                               FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Physical accuracy" FontSize="25" FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                    <TextBlock x:Name="StepText" Text="01 / Set 10 inches" FontSize="14"
                               FontWeight="SemiBold" Margin="0,30,0,0"/>
                    <TextBlock x:Name="InstructionText" TextWrapping="Wrap" LineHeight="21"
                               Foreground="#C0C0C0" FontSize="12" Margin="0,12,0,0"
                               Text="Drag the white corner handle until the rectangle measures exactly 10 inches diagonally with a real ruler."/>
                    <TextBlock Text="Measure from the upper-left OUTER corner to the lower-right OUTER corner, diagonally."
                               Foreground="#A7A7A7" FontSize="11" TextWrapping="Wrap"
                               LineHeight="17" Margin="0,20,0,0"/>
                    <Border Background="#1E1E1E" CornerRadius="8"
                            Padding="12" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected physical display" Foreground="#989898" FontSize="10"/>
                            <TextBlock x:Name="DisplayLabel" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                            <TextBlock x:Name="PixelDimensionsText" TextWrapping="Wrap"
                                       Foreground="#BBBBBB" FontSize="11" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VerificationLabel" Text="Measured diagonal (inches)"
                               Foreground="#AAAAAA" FontSize="11" Margin="0,22,0,7"
                               Visibility="Collapsed"/>
                    <TextBox x:Name="VerificationBox" Style="{StaticResource MuxTextBox}"
                             FontSize="14" Text="" Visibility="Collapsed"/>
                    <TextBlock x:Name="ErrorText" Foreground="#FFFFFF" TextWrapping="Wrap"
                               FontSize="11" Margin="0,14,0,0" Visibility="Collapsed"/>
                    <Button x:Name="ActionButton" Content="Match 10-inch reference"
                            Style="{StaticResource MuxPrimaryButton}"
                            Padding="14,13" Margin="0,24,0,0" Click="ActionButton_Click"/>
                    <Button x:Name="SaveButton" Content="Verify and save"
                            Style="{StaticResource MuxPrimaryButton}" Padding="14,13"
                            Margin="0,10,0,0" Click="SaveButton_Click"
                            Visibility="Collapsed"/>
                    <Button Content="Cancel" Style="{StaticResource MuxQuietButton}"
                            Padding="12,10" Margin="0,10,0,0" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="One calibration per physical display · Window sizes are diagonal inches"
                           Foreground="#7E7E7E" FontSize="10" TextWrapping="Wrap"
                           Margin="0,24,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>