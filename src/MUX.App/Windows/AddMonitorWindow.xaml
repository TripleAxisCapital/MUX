<Window x:Class="MUX.App.Windows.AddMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add monitor" Width="430" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F20F0F11" BorderBrush="#303036" BorderThickness="1" CornerRadius="20" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.45" ShadowDepth="10" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Add monitor" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Choose the physical size you want MUX to create." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,26,0,0">
                <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,7" />
                <TextBox x:Name="NameBox" Style="{StaticResource MuxTextBox}" Text="Monitor" />

                <TextBlock Text="Diagonal size" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,20,0,7" />
                <Grid>
                    <TextBox x:Name="SizeBox" Style="{StaticResource MuxTextBox}" Text="27" Padding="11,9,42,9" />
                    <TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                </Grid>

                <TextBlock Text="Aspect ratio" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,20,0,7" />
                <ComboBox x:Name="AspectBox" Style="{StaticResource MuxComboBox}" SelectedIndex="0">
                    <ComboBoxItem Content="16:9" />
                    <ComboBoxItem Content="16:10" />
                    <ComboBoxItem Content="21:9" />
                    <ComboBoxItem Content="32:9" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="3:2" />
                </ComboBox>
                <TextBlock x:Name="ErrorText" Foreground="#FF7A7A" FontSize="12" Margin="2,12,0,0" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Cancel" Style="{StaticResource MuxButton}" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="Create monitor" Style="{StaticResource MuxPrimaryButton}" Click="Create_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
