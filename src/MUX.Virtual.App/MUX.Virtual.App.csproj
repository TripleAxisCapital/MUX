<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MUX.Virtual</AssemblyName>
    <RootNamespace>MUX.Virtual.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MUX.App\Assets\mux-app.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\MUX.App\Assets\mux-app.ico" Link="Assets\mux-app.ico" />
    <Resource Include="..\MUX.App\Assets\mux-logo.png" Link="Assets\mux-logo.png" />
    <!-- Reuse Standard's production editor controls/dialogs instead of maintaining a second, drifting editor. -->
    <ProjectReference Include="..\MUX.App\MUX.App.csproj" />
    <ProjectReference Include="..\MUX.Core\MUX.Core.csproj" />
  </ItemGroup>

  <Target Name="RemoveVirtualReleaseSymbols"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <VirtualPublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(VirtualPublishSymbols)" />
  </Target>
</Project>
