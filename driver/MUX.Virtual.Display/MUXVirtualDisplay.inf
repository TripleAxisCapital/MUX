[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=MUXVirtualDisplay.cat
DriverVer=08/25/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%DeviceName%=MuxVirtual_Install, Root\MUXVirtualDisplay
%DeviceName%=MuxVirtual_Install, MUXVirtualDisplay

[SourceDisksFiles]
MUXVirtualDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[MuxVirtual_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MuxVirtual_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=MuxVirtual_HardwareDeviceSettings

[MuxVirtual_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "MUXVirtualDisplayGroup"

[MuxVirtual_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MuxVirtual_Install.NT.Wdf]
UmdfService=MUXVirtualDisplay,MUXVirtualDisplay_Install
UmdfServiceOrder=MUXVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[MUXVirtualDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\MUXVirtualDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
MUXVirtualDisplay.dll

[Strings]
ManufacturerName="Triple Axis Capital"
DiskName="MUX Virtual Display Driver"
DeviceName="MUX Virtual Display Adapter"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
