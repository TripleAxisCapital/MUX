      <DisableSpecificWarnings>28023;6221;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PreprocessorDefinitions>_WIN64;_AMD64_;AMD64;UMDF_DRIVER;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
