<Window x:Class="MUX.App.Windows.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="574" Height="766"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#F7080B0F"
            BorderBrush="#27323D"
            BorderThickness="1"
            CornerRadius="18"
            Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="34" Opacity="0.52" ShadowDepth="10" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="INPUT CONTROL"
                           Foreground="{StaticResource SubtleBrush}"
                           FontSize="8"
                           FontWeight="SemiBold" />
                <TextBlock Text="Keyboard shortcuts"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                <TextBlock Text="Select a command, then press the key combination you want MUX to own."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Maximize / restore" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Fit the foreground app to its MUX monitor."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button x:Name="ToggleButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="ToggleButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MUX Fullscreen" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Make the app borderless and fill only its MUX monitor."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="FullscreenButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="FullscreenButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Black bars / Stream Deck" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Toggle every configured black edge cover together."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="EdgeCoversButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="EdgeCoversButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto Arrange / Stream Deck" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Size, sort and link normal windows on the cursor display."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="AutoArrangeButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="AutoArrangeButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Previous monitor" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Move the foreground app left through the layout."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button x:Name="PreviousButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="PreviousButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Next monitor" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Move the foreground app right through the layout."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button x:Name="NextButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="NextButton_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MuxCard}" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Edit layout" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Open the full-display MUX layout editor."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button x:Name="EditButton" Grid.Column="1"
                                    Style="{StaticResource MuxButton}"
                                    HorizontalContentAlignment="Center"
                                    Click="EditButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Stream Deck can send either the Black bars shortcut or Auto Arrange shortcut above. Auto Arrange always acts on the display under the cursor."
                               TextWrapping="Wrap"
                               Foreground="#616D79"
                               FontSize="9"
                               LineHeight="14"
                               Margin="2,12,2,0" />
                    <TextBlock x:Name="ErrorText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="10"
                               Margin="2,9,2,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Restore defaults"
                        Style="{StaticResource MuxQuietButton}"
                        Padding="12,8"
                        Click="Defaults_Click" />
                <Button Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource MuxQuietButton}"
                        Padding="18,8"
                        Click="Cancel_Click" />
                <Button Grid.Column="4"
                        Content="Save shortcuts"
                        Style="{StaticResource MuxPrimaryButton}"
                        Padding="18,8"
                        Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
