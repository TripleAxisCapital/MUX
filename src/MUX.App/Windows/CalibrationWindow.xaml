<Window x:Class="MUX.App.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#F5080A0D"
        ShowInTaskbar="False" Topmost="True">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="116" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,36">
            <TextBlock Text="PHYSICAL CALIBRATION"
                       Foreground="{StaticResource SubtleBrush}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Calibrate MUX"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,7,0,0" />
            <TextBlock Text="Measure the reference line with a real ruler or tape measure."
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Canvas x:Name="LineCanvas" Grid.Row="1" Margin="60,0" ClipToBounds="False">
            <Border x:Name="MeasureLine" Height="2" Background="{StaticResource AccentBrush}" />
            <Border x:Name="LeftTick" Width="2" Height="24" Background="{StaticResource AccentBrush}" />
            <Border x:Name="RightTick" Width="2" Height="24" Background="{StaticResource AccentBrush}" />
        </Canvas>

        <Border Grid.Row="2"
                Width="560"
                HorizontalAlignment="Center"
                Style="{StaticResource MuxCard}"
                Padding="22">
            <StackPanel>
                <TextBlock Text="REFERENCE: 10.00 IN"
                           Foreground="{StaticResource SubtleBrush}"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="What does the line actually measure?"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,9,0,0" />

                <Grid Width="310" HorizontalAlignment="Center" Margin="0,19,0,0">
                    <TextBox x:Name="MeasuredBox"
                             Text="10.00"
                             Style="{StaticResource MuxTextBox}"
                             Padding="11,9,42,9" />
                    <TextBlock Text="in"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,13,0"
                               FontSize="10" />
                </Grid>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="10"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0">
                    <Button Content="Cancel"
                            Width="122"
                            Style="{StaticResource MuxQuietButton}"
                            Click="Cancel_Click" />
                    <Button Content="Reset"
                            Width="122"
                            Margin="8,0,0,0"
                            Style="{StaticResource MuxButton}"
                            Click="Reset_Click" />
                    <Button Content="Calibrate"
                            Width="142"
                            Margin="8,0,0,0"
                            Style="{StaticResource MuxPrimaryButton}"
                            Click="Calibrate_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Esc to cancel"
                   Foreground="#4D5863"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,26" />
    </Grid>
</Window>
