<Window x:Class="MUX.Virtual.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MUX.App.Controls;assembly=MUX"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MUX Virtual Displays"
        Width="1320" Height="820" MinWidth="1120" MinHeight="700"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0D0D0F">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="MUX" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="  /  Virtual display workspace" Foreground="#676770" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="48" Height="46" Background="Transparent" BorderThickness="0" Foreground="#A0A0A8" FontSize="16" Click="Minimize_Click" />
                <Button Content="×" Width="48" Height="46" Background="Transparent" BorderThickness="0" Foreground="#A0A0A8" FontSize="19" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="304" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D0D0F" BorderBrush="#1F1F23" BorderThickness="0,1,1,0" Padding="18,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="One display. Many." FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Create real Windows monitors from the same physical MUX workspace." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18" Margin="0,8,4,0" />
                    </StackPanel>

                    <Button x:Name="EngineToggleButton" Grid.Row="1" Style="{StaticResource MuxButton}" HorizontalContentAlignment="Stretch" Margin="0,22,0,18" Click="EngineToggle_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Virtual Engine" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="EngineSubtitle" Text="Stopped" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="EngineDot" Grid.Column="1" Width="9" Height="9" CornerRadius="5" Background="#62626A" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="LAYOUTS" Foreground="#65656D" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,9" />
                        <ListBox x:Name="LayoutList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White"
                                 SelectionChanged="LayoutList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,10" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#17171A" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#242428" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="+ New" Style="{StaticResource MuxButton}" Padding="9,7" Click="NewLayout_Click" />
                            <Button Grid.Column="2" Content="Delete" Style="{StaticResource MuxButton}" Padding="9,7" Click="DeleteLayout_Click" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3" Background="#121214" BorderBrush="#242428" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="DRIVER" Foreground="#65656D" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="DriverSidebarText" Text="Checking…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" LineHeight="15" Margin="0,7,0,0" />
                            <Button x:Name="InstallDriverButton" Content="Install driver" Style="{StaticResource MuxButton}" Padding="9,7" Margin="0,10,0,0" Click="InstallDriver_Click" />
                            <Button x:Name="DevelopmentModeButton" Content="Enable development mode" Style="{StaticResource MuxButton}" Padding="9,7" Margin="0,8,0,0" Click="DevelopmentMode_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Grid Margin="30,25,30,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LayoutTitle" Text="Workspace" FontSize="29" FontWeight="SemiBold" />
                        <TextBlock x:Name="LayoutSubtitle" Text="0 virtual monitors" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Add monitor" Style="{StaticResource MuxButton}" Click="AddMonitor_Click" />
                        <Button Content="Edit on display" Margin="9,0,0,0" Style="{StaticResource MuxButton}" Click="EditOnDisplay_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="28,0,28,0" Background="#0D0D0F" BorderBrush="#222226" BorderThickness="1" CornerRadius="22">
                    <Grid>
                        <controls:LayoutCanvas x:Name="WorkspaceCanvas" />
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="Create your first monitor" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a physical size, then place it anywhere on your display." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="30,14,30,22">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#787882" FontSize="10" />
                        <TextBlock Text="Ctrl + Alt + Esc releases the cursor from a virtual monitor portal." Foreground="#5F5F67" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save" Style="{StaticResource MuxButton}" Padding="16,7" Click="Save_Click" />
                    <Button x:Name="ActivateButton" Grid.Column="3" Content="Activate virtual displays" Style="{StaticResource MuxPrimaryButton}" Padding="16,7" Click="Activate_Click" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="#0D0D0F" BorderBrush="#1F1F23" BorderThickness="1,1,0,0" Padding="20,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PHYSICAL DISPLAY" Foreground="#65656D" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10" />
                        <ComboBox x:Name="DisplayCombo" Style="{StaticResource MuxComboBox}" SelectionChanged="DisplayCombo_SelectionChanged" />

                        <TextBlock Text="Physical diagonal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,18,0,7" />
                        <Grid>
                            <TextBox x:Name="DisplaySizeBox" Style="{StaticResource MuxTextBox}" Padding="11,9,42,9" LostFocus="DisplaySizeBox_LostFocus" />
                            <TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                        </Grid>
                        <TextBlock x:Name="DisplayMetricsText" Foreground="#696972" FontSize="10" Margin="2,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Calibrate with ruler" Style="{StaticResource MuxButton}" Margin="0,12,0,0" Click="Calibrate_Click" />
                        <Button Content="Windows display settings" Style="{StaticResource MuxButton}" Margin="0,8,0,0" Click="DisplaySettings_Click" />

                        <Border Height="1" Background="#242428" Margin="0,22,0,20" />

                        <StackPanel x:Name="ZoneInspector" Visibility="Collapsed">
                            <TextBlock Text="SELECTED MONITOR" Foreground="#65656D" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10" />
                            <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,7" />
                            <TextBox x:Name="ZoneNameBox" Style="{StaticResource MuxTextBox}" />

                            <TextBlock Text="Diagonal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,16,0,7" />
                            <Grid>
                                <TextBox x:Name="ZoneSizeBox" Style="{StaticResource MuxTextBox}" Padding="11,9,42,9" />
                                <TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                            </Grid>

                            <TextBlock Text="Aspect ratio" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,16,0,7" />
                            <ComboBox x:Name="ZoneAspectBox" Style="{StaticResource MuxComboBox}">
                                <ComboBoxItem Content="16:9" /><ComboBoxItem Content="16:10" /><ComboBoxItem Content="21:9" />
                                <ComboBoxItem Content="32:9" /><ComboBoxItem Content="4:3" /><ComboBoxItem Content="3:2" />
                            </ComboBox>
                            <TextBlock x:Name="ZoneResolutionText" Foreground="#696972" FontSize="10" Margin="2,8,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Update" Style="{StaticResource MuxButton}" Padding="9,7" Click="UpdateZone_Click" />
                                <Button Grid.Column="2" Content="Remove" Style="{StaticResource MuxButton}" Padding="9,7" Click="DeleteZone_Click" />
                            </Grid>
                            <Button Content="Clone monitor" Style="{StaticResource MuxButton}" Padding="9,7" Margin="0,8,0,0" Click="CloneZone_Click" />
                            <Border Height="1" Background="#242428" Margin="0,22,0,20" />
                        </StackPanel>

                        <TextBlock Text="BEHAVIOR" Foreground="#65656D" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10" />
                        <CheckBox x:Name="StartupCheck" Content="Launch MUX Virtual at sign in" Style="{StaticResource MuxCheckBox}" Click="StartupChanged_Click" />
                        <Button Content="Customize shortcuts" Style="{StaticResource MuxButton}" Margin="0,12,0,0" Click="CustomizeShortcuts_Click" />

                        <Border Background="#121214" BorderBrush="#242428" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Keyboard" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="ShortcutMaximizeText" Text="Ctrl + Alt + M   Maximize / restore" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" />
                                <TextBlock x:Name="ShortcutFullscreenText" Text="Ctrl + Alt + F   Native fullscreen" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                <TextBlock x:Name="ShortcutPreviousText" Text="Ctrl + Alt + ←   Previous monitor" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                <TextBlock x:Name="ShortcutNextText" Text="Ctrl + Alt + →   Next monitor" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                <TextBlock x:Name="ShortcutEditText" Text="Ctrl + Alt + E   Edit layout" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#121214" BorderBrush="#242428" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="True monitor mode" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="When active, Windows sees each MUX region as a real monitor. Maximize and browser F11 therefore use the native virtual-monitor bounds." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" LineHeight="15" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
