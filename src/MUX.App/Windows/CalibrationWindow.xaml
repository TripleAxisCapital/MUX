<Window Icon="pack://application:,,,/Assets/mux-logo.png"
        x:Class="MUX.App.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Background="#F50A0A0A"
        ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,34">
            <TextBlock Text="PHYSICAL DISPLAY CALIBRATION" Foreground="{StaticResource SubtleBrush}" FontSize="10"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Match real inches to screen pixels" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="DisplayLabel" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
            <TextBlock Text="Use a ruler against the screen. Measure the distance between the two vertical ticks."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <Canvas x:Name="LineCanvas" Grid.Row="1" Margin="40,0" ClipToBounds="False">
            <Border x:Name="MeasureLine" Height="3" Background="#DADADA"/>
            <Border x:Name="LeftTick" Width="2" Height="28" Background="#F1F1F1"/>
            <Border x:Name="RightTick" Width="2" Height="28" Background="#F1F1F1"/>
        </Canvas>

        <Border Grid.Row="2" Width="560" HorizontalAlignment="Center" Style="{StaticResource MuxCard}" Padding="22">
            <StackPanel>
                <TextBlock x:Name="StepLabel" Text="STEP 1 / 2  ·  MEASURE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource SubtleBrush}"/>
                <TextBlock x:Name="InstructionLabel" Text="Enter the actual length of the line, not the expected length."
                           TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"/>
                <Grid Width="260" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBox x:Name="MeasuredBox" Text="6.00" Style="{StaticResource MuxTextBox}"
                             Padding="12,10,45,10"/>
                    <TextBlock Text="in" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </Grid>
                <TextBlock x:Name="StatusLabel" Text="Use the two ticks as endpoints. Do not measure the outer display bezel."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#E0E0E0" TextWrapping="Wrap"
                           FontSize="11" TextAlignment="Center" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Cancel" Width="105" Style="{StaticResource MuxQuietButton}" Click="Cancel_Click"/>
                    <Button Content="Reset" Width="105" Margin="8,0,0,0" Style="{StaticResource MuxButton}"
                            Click="Reset_Click"/>
                    <Button x:Name="ApplyButton" Content="Apply correction" Width="136" Margin="8,0,0,0"
                            Style="{StaticResource MuxButton}" Click="Calibrate_Click"/>
                    <Button x:Name="SaveCalibrationButton" Content="Save" Width="95" Margin="8,0,0,0"
                            IsEnabled="False" Style="{StaticResource MuxPrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Calibration applies to the selected physical display. Zone sizes are measured diagonally."
                   Foreground="#A0A0A0" TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18,0,18,26"/>
    </Grid>
</Window>