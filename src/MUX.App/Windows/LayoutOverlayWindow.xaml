<Window x:Class="MUX.App.Windows.LayoutOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#E6080A0D"
        ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Canvas x:Name="ZoneCanvas" Background="Transparent" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,22,0,0"
                Background="#F20C1015"
                BorderBrush="#2A3540"
                BorderThickness="1"
                CornerRadius="15"
                Padding="16,11">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.42" ShadowDepth="7" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24"
                        CornerRadius="8"
                        Background="#121920"
                        BorderBrush="#26323D"
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource SuccessBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Edit layout" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="DisplayLabel"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="Cancel"
                        Style="{StaticResource MuxQuietButton}"
                        Padding="13,7"
                        Click="Cancel_Click" />
                <Button Content="Save layout"
                        Style="{StaticResource MuxPrimaryButton}"
                        Padding="15,7"
                        Margin="7,0,0,0"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Background="#B30B0F14"
                BorderBrush="#202A34"
                BorderThickness="1"
                CornerRadius="9"
                Padding="10,6"
                IsHitTestVisible="False">
            <TextBlock Text="DRAG TO POSITION  ·  PHYSICAL SCALE LOCKED  ·  ESC TO CANCEL"
                       Foreground="#64717D"
                       FontSize="8"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
