<Application x:Class="MUX.Virtual.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#17191D"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2D33"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9EA3AD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F4F5F7"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="Background" Value="#F4F5F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#24272D"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7E9ED"/>
            <Setter Property="Background" Value="#24272D"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Application.Resources>
</Application>
