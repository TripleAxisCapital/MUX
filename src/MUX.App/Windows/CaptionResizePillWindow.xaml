<Window x:Class="MUX.App.Windows.CaptionResizePillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="224" Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MagnetWindow_Loaded"
        Closed="MagnetWindow_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#202024" />
            <Setter Property="BorderBrush" Value="#3A3A40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#202024" />
            <Setter Property="BorderBrush" Value="#3A3A40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="PillButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#242428" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#303036" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#3A3A41" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoritePillButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#1F1F23" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="PillTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#111114" />
            <Setter Property="BorderBrush" Value="#4A4A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#F5F5F7" />
            <Setter Property="SelectionBrush" Value="#45454F" />
            <Setter Property="SelectionOpacity" Value="0.7" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="FieldRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldRoot" Property="BorderBrush" Value="#85858F" />
                                <Setter TargetName="FieldRoot" Property="Background" Value="#17171B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Background="#F218181B"
            BorderBrush="#3A3A40"
            BorderThickness="1"
            CornerRadius="26"
            Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.42" Color="#000000" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid x:Name="CollapsedPanel" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="FavoritesScroll"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="FavoritesScroll_PreviewMouseWheel">
                    <StackPanel x:Name="FavoritesPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" />
                </ScrollViewer>

                <Button x:Name="SizeButton"
                        Grid.Column="2"
                        Height="34"
                        Style="{StaticResource PillButton}"
                        Content="Size"
                        ToolTip="Set size in physical inches"
                        Click="Expand_Click" />

                <Button x:Name="RatioButton"
                        Grid.Column="4"
                        Height="34"
                        Style="{StaticResource PillButton}"
                        Content="16:9"
                        ToolTip="Aspect ratio"
                        Click="RatioButton_Click" />

                <Grid Grid.Column="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="34"
                            Background="#111114"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="5,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="CurrentSize_MouseLeftButtonUp">
                        <TextBlock x:Name="CurrentSizeText"
                                   Text="— in"
                                   Foreground="#D0D0D6"
                                   FontWeight="SemiBold"
                                   FontSize="10.5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Button x:Name="MagnetButton"
                            Grid.Column="2"
                            Width="26"
                            Height="34"
                            Style="{StaticResource PillButton}"
                            Padding="4"
                            ToolTip="Magnetic window snapping"
                            Click="MagnetButton_Click">
                        <Viewbox Width="15" Height="15" Stretch="Uniform">
                            <Path x:Name="MagnetGlyph"
                                  Fill="#F5F5F7"
                                  Data="M2,1 H6 V8 C6,9.7 7.3,11 9,11 C10.7,11 12,9.7 12,8 V1 H16 V8 C16,11.9 12.9,15 9,15 C5.1,15 2,11.9 2,8 Z" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="ExpandedScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel x:Name="ExpandedPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="EditorTitleText"
                               Width="44"
                               Text="Diagonal"
                               Foreground="#A6A6AE"
                               FontSize="10"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="DiagonalBox"
                             Width="70"
                             Margin="6,0,0,0"
                             Style="{StaticResource PillTextBox}"
                             VerticalAlignment="Center"
                             ToolTip="Physical diagonal in inches"
                             PreviewKeyDown="DiagonalBox_PreviewKeyDown" />

                    <TextBlock Width="20"
                               Text="in"
                               Foreground="#A6A6AE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <Button x:Name="FavoriteActionButton"
                            Width="34"
                            Height="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource PillButton}"
                            Padding="7,6"
                            Content="+"
                            FontSize="17"
                            ToolTip="Add this size to favorites"
                            Click="FavoriteAction_Click" />

                    <Button x:Name="EditorRatioButton"
                            Width="58"
                            Height="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource PillButton}"
                            Content="16:9"
                            ToolTip="Aspect ratio"
                            Click="RatioButton_Click" />

                    <Button Width="52"
                            Height="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource PillButton}"
                            Content="Apply"
                            Click="Apply_Click" />

                    <Button Width="30"
                            Height="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource PillButton}"
                            Padding="6,6"
                            Content="‹"
                            FontSize="16"
                            ToolTip="Back"
                            Click="Collapse_Click" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="RatioEditorPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Width="44"
                           Text="Ratio"
                           Foreground="#A6A6AE"
                           FontSize="10"
                           VerticalAlignment="Center" />

                <TextBox x:Name="CustomRatioBox"
                         Width="92"
                         Margin="6,0,0,0"
                         Style="{StaticResource PillTextBox}"
                         VerticalAlignment="Center"
                         ToolTip="Type a ratio such as 21:9 or 2.39:1"
                         PreviewKeyDown="CustomRatioBox_PreviewKeyDown" />

                <Button Width="52"
                        Height="34"
                        Margin="6,0,0,0"
                        Style="{StaticResource PillButton}"
                        Content="Save"
                        Click="SaveRatio_Click" />

                <Button Width="30"
                        Height="34"
                        Margin="6,0,0,0"
                        Style="{StaticResource PillButton}"
                        Padding="6,6"
                        Content="‹"
                        FontSize="16"
                        ToolTip="Back"
                        Click="Collapse_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
