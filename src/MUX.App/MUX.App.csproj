<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MUX</AssemblyName>
    <RootNamespace>MUX.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mux-app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <StartupObject>MUX.App.App</StartupObject>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Company>Triple Axis Capital</Company>
    <Product>MUX</Product>
    <Description>Physical workspace control system for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\mux-app.ico" />
    <Resource Include="Assets\mux-logo.png" />
    <ProjectReference Include="..\MUX.Core\MUX.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Every published Standard package gets genuine NativeAOT Stream Deck helpers. -->
  <Target Name="PublishStreamDeckLaunchers" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_StreamDeckProject>$(MSBuildProjectDirectory)\..\MUX.StreamDeckLauncher\MUX.StreamDeckLauncher.csproj</_StreamDeckProject>
      <_StreamDeckPublishDir>$(PublishDir)streamdeck-launcher\</_StreamDeckPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(_StreamDeckProject)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishAot=true -o &quot;$(_StreamDeckPublishDir)&quot;" />
    <Error Condition="!Exists('$(_StreamDeckPublishDir)MUX-StreamDeckLauncher.exe')"
           Text="Native Stream Deck launcher publish did not produce MUX-StreamDeckLauncher.exe." />
    <Copy SourceFiles="$(_StreamDeckPublishDir)MUX-StreamDeckLauncher.exe"
          DestinationFiles="$(PublishDir)MUX-AutoArrange.exe" />
    <Copy SourceFiles="$(_StreamDeckPublishDir)MUX-StreamDeckLauncher.exe"
          DestinationFiles="$(PublishDir)MUX-BlackBars.exe" />
    <Copy SourceFiles="$(_StreamDeckPublishDir)MUX-StreamDeckLauncher.exe"
          DestinationFiles="$(PublishDir)MUX-ScreenBars.exe" />
    <RemoveDir Directories="$(_StreamDeckPublishDir)" />
  </Target>
</Project>
