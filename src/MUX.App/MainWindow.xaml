<Window x:Class="MUX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MUX.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MUX" Width="1190" Height="760" MinWidth="1040" MinHeight="680"
        Background="{StaticResource BackgroundBrush}" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ShellBrush}" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#151515" BorderBrush="#2B2B2B" BorderThickness="1">
                        <Image Width="19" Height="19" Source="pack://application:,,,/Assets/mux-logo.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MUX" FontSize="13" FontWeight="SemiBold"/>
                        
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="UpdateStatusCapsule" Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="9,5" Margin="0,0,7,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="UpdateStatusDot" Width="6" Height="6" Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" Text="Managed updates" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateVersionText" Text="Starting" FontSize="8" Foreground="{StaticResource SubtleBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgressBar" VerticalAlignment="Bottom" Margin="0,0,0,-5" Width="108" Style="{StaticResource MuxProgressBar}" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button Content="Settings" Style="{StaticResource MuxHeaderButton}" Padding="11,7" Margin="0,0,7,0" Click="SettingsButton_Click"/>
                    <Button x:Name="UpdateButton" Content="Check" Style="{StaticResource MuxHeaderButton}" Padding="11,7" Margin="0,0,7,0" Click="UpdateButton_Click"/>
                    <Button Content="—" Width="38" Height="36" Background="Transparent" BorderThickness="0" Foreground="#878787" FontSize="14" Cursor="Hand" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="□" Width="38" Height="36" Background="Transparent" BorderThickness="0" Foreground="#878787" FontSize="13" Cursor="Hand" Click="MaximizeRestore_Click"/>
                    <Button Content="×" Width="38" Height="36" Background="Transparent" BorderThickness="0" Foreground="#878787" FontSize="17" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainWorkspaceView" Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MuxCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="EngineToggleButton" Style="{StaticResource MuxButton}" HorizontalContentAlignment="Stretch" Padding="11,10" Click="EngineToggle_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Window engine" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="EngineSubtitle" Text="Active" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="#0E0E0E" BorderBrush="#2E2E2E" BorderThickness="1"><Border x:Name="EngineDot" Width="7" Height="7" CornerRadius="4" Background="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </Grid>
                    </Button>
                    <TextBlock Grid.Row="1" Text="WORKSPACES" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold" Margin="3,18,0,8"/>
                    <ListBox x:Name="LayoutList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="LayoutList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#161616"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F1F1F"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="+ New" Style="{StaticResource MuxButton}" Padding="8" Click="NewLayout_Click"/><Button Grid.Column="2" Content="Delete" Style="{StaticResource MuxQuietButton}" Padding="8" Click="DeleteLayout_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="7,2,7,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ACTIVE WORKSPACE" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock x:Name="LayoutTitle" Text="Workspace" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="LayoutSubtitle" Text="0 virtual monitors" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Style="{StaticResource MuxPrimaryButton}" Padding="14,9" Click="AddMonitor_Click"><TextBlock Text="+ Monitor" Foreground="{StaticResource AccentTextBrush}"/></Button><Button Content="Edit on display" Margin="7,0,0,0" Style="{StaticResource MuxButton}" Padding="14,9" Click="EditOnDisplay_Click"/></StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource MuxCard}" CornerRadius="18" ClipToBounds="True">
                    <Grid Background="#0C0C0C">
                        <Grid Margin="18"><controls:LayoutCanvas x:Name="WorkspaceCanvas"/><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border Width="46" Height="46" CornerRadius="14" Background="#171717" BorderBrush="#2F2F2F" BorderThickness="1"><TextBlock Text="+" FontSize="23" FontWeight="Light" Foreground="#969696" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="No monitors yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,0"/><TextBlock Text="Add a monitor to create your workspace." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="7,11,7,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changes save automatically" Foreground="{StaticResource SubtleBrush}" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Save now" Style="{StaticResource MuxQuietButton}" Padding="12,7" Click="Save_Click"/></Grid>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource MuxCard}" Padding="15">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="Physical source" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,9"/>
                    <ComboBox x:Name="DisplayCombo" Style="{StaticResource MuxComboBox}" SelectionChanged="DisplayCombo_SelectionChanged"/>
                    <TextBlock Text="Physical diagonal" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,13,0,6"/>
                    <Grid><TextBox x:Name="DisplaySizeBox" Style="{StaticResource MuxTextBox}" Padding="11,8,38,8" LostFocus="DisplaySizeBox_LostFocus"/><TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="10"/></Grid>
                    <TextBlock x:Name="DisplayMetricsText" Foreground="#969696" FontSize="9" Margin="2,7,0,0" TextWrapping="Wrap" LineHeight="13"/>
                    <Button Content="Calibrate physical scale" Style="{StaticResource MuxButton}" Margin="0,10,0,0" Padding="10,8" Click="Calibrate_Click"/>
                    <Border Height="1" Background="#272727" Margin="0,17,0,15"/>
                    <StackPanel x:Name="ZoneInspector" Visibility="Collapsed">
                        <TextBlock Text="SELECTED MONITOR" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <TextBox x:Name="ZoneNameBox" Style="{StaticResource MuxTextBox}"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="ZoneSizeBox" Style="{StaticResource MuxTextBox}" Padding="11,8,38,8"/><TextBlock Text="in" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="10"/></Grid><ComboBox x:Name="ZoneAspectBox" Grid.Column="2" Style="{StaticResource MuxComboBox}"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="16:10"/><ComboBoxItem Content="21:9"/><ComboBoxItem Content="32:9"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="3:2"/></ComboBox></Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Update" Style="{StaticResource MuxButton}" Padding="8" Click="UpdateZone_Click"/><Button Grid.Column="2" Content="Remove" Style="{StaticResource MuxQuietButton}" Padding="8" Click="DeleteZone_Click"/></Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="6,1,6,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="← Back" Style="{StaticResource MuxQuietButton}" Padding="9,7" Click="SettingsBack_Click"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="SETTINGS" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="Preferences" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource MuxCard}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsBehaviorStack">
                            <CheckBox x:Name="SnapCheck" Content="Snap windows to monitors" Style="{StaticResource MuxCheckBox}" Click="BehaviorChanged_Click"/>
                            <CheckBox x:Name="StartupCheck" Content="Launch at sign in" Style="{StaticResource MuxCheckBox}" Margin="0,11,0,0" Click="StartupChanged_Click"/>
                            <Border Background="#0F0F0F" BorderBrush="#272727" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,16,0,0"><StackPanel><TextBlock Text="Keyboard" FontSize="10" FontWeight="SemiBold" Foreground="#B2B2B2"/><TextBlock Text="Ctrl + Alt + M   Maximize / restore" Foreground="#9A9A9A" FontSize="9" Margin="0,6,0,0"/><TextBlock Text="Ctrl + Alt + F   MUX Fullscreen" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="Ctrl + Alt + B   Black bars / Stream Deck" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="Ctrl + Alt + ←   Previous monitor" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="Ctrl + Alt + →   Next monitor" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="Ctrl + Alt + E   Edit layout" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="Ctrl + Alt + A   Auto Arrange" Foreground="#9A9A9A" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MuxCard}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <TextBlock Text="STREAM DECK" Foreground="{StaticResource SubtleBrush}" FontSize="8" FontWeight="SemiBold"/><TextBlock Text="Button setup" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="For each Stream Deck key, choose System → Open, then use the matching MUX launcher below." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,13"/>
                        <Border Background="#0F0F0F" BorderBrush="#272727" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="8" Background="#1C1C1C"><TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="Auto Arrange" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="MUX-AutoArrange.exe" Foreground="#9A9A9A" FontSize="9"/></StackPanel><Button Grid.Column="2" Content="Copy path" Tag="MUX-AutoArrange.exe" Style="{StaticResource MuxButton}" Padding="10,7" Click="StreamDeckCopy_Click"/></Grid></Border>
                        <Border Background="#0F0F0F" BorderBrush="#272727" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="8" Background="#1C1C1C"><TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="Window black bars" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="MUX-BlackBars.exe" Foreground="#9A9A9A" FontSize="9"/></StackPanel><Button Grid.Column="2" Content="Copy path" Tag="MUX-BlackBars.exe" Style="{StaticResource MuxButton}" Padding="10,7" Click="StreamDeckCopy_Click"/></Grid></Border>
                        <Border Background="#0F0F0F" BorderBrush="#272727" BorderThickness="1" CornerRadius="11" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="8" Background="#1C1C1C"><TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="Screen bars" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="MUX-ScreenBars.exe" Foreground="#9A9A9A" FontSize="9"/></StackPanel><Button Grid.Column="2" Content="Copy path" Tag="MUX-ScreenBars.exe" Style="{StaticResource MuxButton}" Padding="10,7" Click="StreamDeckCopy_Click"/></Grid></Border>
                        <Button Content="Open MUX installation folder" Style="{StaticResource MuxButton}" Padding="11,8" Margin="0,12,0,0" Click="OpenInstallFolder_Click"/>
                        <TextBlock x:Name="StreamDeckSetupStatusText" Text="These launchers start MUX silently if it is not already running." Foreground="#9A9A9A" FontSize="9" TextWrapping="Wrap" LineHeight="14" Margin="2,8,2,0"/>
                        <Border Height="1" Background="#272727" Margin="0,18,0,16"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
