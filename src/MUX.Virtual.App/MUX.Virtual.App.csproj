<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MUX.Virtual</AssemblyName>
    <RootNamespace>MUX.Virtual.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MUX.App\Assets\mux-app.ico</ApplicationIcon>

    <!--
      Keep the controller self-contained, but deliberately do not bundle it into
      one self-extracting executable. A normal multi-file publish is more
      transparent to Windows security scanners and avoids extracting the WPF/.NET
      runtime into a temporary directory every time MUX Virtual starts.
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\MUX.App\Assets\mux-app.ico" Link="Assets\mux-app.ico" />
    <Resource Include="..\MUX.App\Assets\mux-logo.png" Link="Assets\mux-logo.png" />
    <ProjectReference Include="..\MUX.Core\MUX.Core.csproj" />
  </ItemGroup>
</Project>
