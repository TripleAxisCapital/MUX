<Window x:Class="MUX.App.Windows.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="264"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="#F7080B0F"
            BorderBrush="#27323D"
            BorderThickness="1"
            CornerRadius="18"
            Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="32" Opacity="0.5" ShadowDepth="9" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText"
                       Grid.Row="1"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBox x:Name="ValueBox"
                     Grid.Row="2"
                     Style="{StaticResource MuxTextBox}"
                     Margin="0,20,0,0"
                     VerticalAlignment="Top" />

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Cancel"
                        Style="{StaticResource MuxQuietButton}"
                        Click="Cancel_Click" />
                <Button Grid.Column="2"
                        Content="Save"
                        Style="{StaticResource MuxPrimaryButton}"
                        Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
