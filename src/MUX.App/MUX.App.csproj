<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MUX</AssemblyName>
    <RootNamespace>MUX.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mux-app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\mux-app.ico" />
    <Resource Include="Assets\mux-logo.png" />
    <ProjectReference Include="..\MUX.Core\MUX.Core.csproj" />
  </ItemGroup>

  <!--
    Stream Deck's simple Open action does not expose command-line arguments consistently across
    profiles/plugins. The published single-file MUX binary is therefore copied to a dedicated
    launcher name. AutoArrangeCommandBootstrap recognizes that filename, signals the resident MUX
    process, then exits. If MUX is not running yet it starts the canonical MUX.exe in background.
  -->
  <Target Name="CreateAutoArrangeLauncherAlias" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)MUX.exe"
          DestinationFiles="$(PublishDir)MUX-AutoArrange.exe"
          Condition="Exists('$(PublishDir)MUX.exe')" />
  </Target>
</Project>
