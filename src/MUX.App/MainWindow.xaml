<Window x:Class="MUX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MUX.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MUX" Width="1260" Height="820" MinWidth="1120" MinHeight="700"
        Background="{StaticResource BackgroundBrush}" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ShellBrush}"
                BorderBrush="#151B22"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#111820" BorderBrush="#25303B" BorderThickness="1" CornerRadius="9">
                        <Image Width="20" Height="20"
                               Source="pack://application:,,,/Assets/mux-logo.png"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MUX" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="WINDOW SYSTEM" Foreground="{StaticResource SubtleBrush}"
                                   FontSize="8" FontWeight="SemiBold" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="UpdateStatusCapsule"
                            Background="#0D1218"
                            BorderBrush="#202A34"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="10,6"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="UpdateStatusDot" Width="6" Height="6"
                                         Fill="{StaticResource SubtleBrush}" Margin="0,0,7,0" />
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" Text="Managed updates" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateVersionText" Text="Starting" FontSize="8"
                                               Foreground="{StaticResource SubtleBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Grid.ColumnSpan="2"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,-6"
                                         Width="112"
                                         Style="{StaticResource MuxProgressBar}"
                                         Minimum="0" Maximum="100"
                                         Value="0"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Button x:Name="UpdateButton"
                            Content="Check"
                            Style="{StaticResource MuxHeaderButton}"
                            Margin="0,0,10,0"
                            Click="UpdateButton_Click" />

                    <Button Content="—" Width="42" Height="38"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#7E8994" FontSize="14"
                            Cursor="Hand" Click="Minimize_Click" />
                    <Button Content="×" Width="42" Height="38"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#7E8994" FontSize="17"
                            Cursor="Hand" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,14,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MuxCard}" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="EngineToggleButton"
                            Style="{StaticResource MuxButton}"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,11"
                            Click="EngineToggle_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Window engine" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="EngineSubtitle" Text="Active"
                                           FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="20" Height="20"
                                    CornerRadius="10"
                                    Background="#0B0F14"
                                    BorderBrush="#24303A"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="EngineDot"
                                        Width="7" Height="7"
                                        CornerRadius="4"
                                        Background="{StaticResource SuccessBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <Grid Grid.Row="1" Margin="3,20,3,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WORKSPACES"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="8" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="LAYOUT"
                                   Foreground="#3E4852" FontSize="8" />
                    </Grid>

                    <ListBox x:Name="LayoutList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             SelectionChanged="LayoutList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemRoot"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="SelectionRail"
                                                            Width="2"
                                                            CornerRadius="1"
                                                            Background="Transparent"
                                                            Margin="0,2,0,2" />
                                                    <ContentPresenter Grid.Column="1" Margin="9,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#11171D" />
                                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#1D2630" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemRoot" Property="Background" Value="#151D25" />
                                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#27323D" />
                                                    <Setter TargetName="SelectionRail" Property="Background" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Content="+ New" Style="{StaticResource MuxButton}" Padding="8,8" Click="NewLayout_Click" />
                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource MuxQuietButton}" Padding="8,8" Click="DeleteLayout_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="8,4,8,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE WORKSPACE"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="8" FontWeight="SemiBold" />
                        <TextBlock x:Name="LayoutTitle" Text="Workspace"
                                   FontSize="26" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="LayoutSubtitle"
                                   Text="0 virtual monitors"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="1,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="+ Monitor"
                                Style="{StaticResource MuxPrimaryButton}"
                                Padding="14,9"
                                Click="AddMonitor_Click" />
                        <Button Content="Edit on display"
                                Margin="7,0,0,0"
                                Style="{StaticResource MuxButton}"
                                Padding="14,9"
                                Click="EditOnDisplay_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource MuxCard}"
                        CornerRadius="18"
                        ClipToBounds="True">
                    <Grid>
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.8" RadiusY="0.8">
                                    <GradientStop Color="#111821" Offset="0" />
                                    <GradientStop Color="#0A0E13" Offset="0.62" />
                                    <GradientStop Color="#080B0F" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="18">
                            <controls:LayoutCanvas x:Name="WorkspaceCanvas" />

                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <Border Width="48" Height="48"
                                        CornerRadius="14"
                                        Background="#111820"
                                        BorderBrush="#26313C"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="+"
                                               FontSize="24"
                                               FontWeight="Light"
                                               Foreground="#708090"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-2,0,0" />
                                </Border>
                                <TextBlock Text="Build your display map"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="Create a monitor, then place it at its real physical size."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="15"
                                Padding="8,5"
                                Background="#B30A0E13"
                                BorderBrush="#252F39"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <TextBlock Text="CALIBRATED PHYSICAL SPACE"
                                       Foreground="#697682"
                                       FontSize="7"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="8,12,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="#4D5965" Margin="0,0,7,0" />
                        <TextBlock Text="Changes save automatically"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Save now"
                            Style="{StaticResource MuxQuietButton}"
                            Padding="12,7"
                            Click="Save_Click" />
                </Grid>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource MuxCard}" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="1,0,1,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DISPLAY"
                                           Foreground="{StaticResource SubtleBrush}"
                                           FontSize="8"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Physical source"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="9"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="20" Height="20"
                                    CornerRadius="10"
                                    Background="#0B0F14"
                                    BorderBrush="#202A34"
                                    BorderThickness="1">
                                <Ellipse Width="5" Height="5"
                                         Fill="{StaticResource SuccessBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <ComboBox x:Name="DisplayCombo"
                                  Style="{StaticResource MuxComboBox}"
                                  SelectionChanged="DisplayCombo_SelectionChanged" />

                        <TextBlock Text="Physical diagonal"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="2,14,0,6" />
                        <Grid>
                            <TextBox x:Name="DisplaySizeBox"
                                     Style="{StaticResource MuxTextBox}"
                                     Padding="11,8,38,8"
                                     LostFocus="DisplaySizeBox_LostFocus" />
                            <TextBlock Text="in"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       FontSize="10" />
                        </Grid>

                        <TextBlock x:Name="DisplayMetricsText"
                                   Foreground="#63707C"
                                   FontSize="9"
                                   Margin="2,7,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="13" />

                        <Button Content="Calibrate physical scale"
                                Style="{StaticResource MuxButton}"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Click="Calibrate_Click" />

                        <Border Height="1" Background="#202833" Margin="0,18,0,16" />

                        <StackPanel x:Name="ZoneInspector" Visibility="Collapsed">
                            <TextBlock Text="SELECTED MONITOR"
                                       Foreground="{StaticResource SubtleBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,9" />
                            <TextBox x:Name="ZoneNameBox" Style="{StaticResource MuxTextBox}" />

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="108" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="ZoneSizeBox"
                                             Style="{StaticResource MuxTextBox}"
                                             Padding="11,8,38,8" />
                                    <TextBlock Text="in"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               FontSize="10" />
                                </Grid>
                                <ComboBox x:Name="ZoneAspectBox"
                                          Grid.Column="2"
                                          Style="{StaticResource MuxComboBox}">
                                    <ComboBoxItem Content="16:9" />
                                    <ComboBoxItem Content="16:10" />
                                    <ComboBoxItem Content="21:9" />
                                    <ComboBoxItem Content="32:9" />
                                    <ComboBoxItem Content="4:3" />
                                    <ComboBoxItem Content="3:2" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Content="Update"
                                        Style="{StaticResource MuxButton}"
                                        Padding="8,8"
                                        Click="UpdateZone_Click" />
                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Style="{StaticResource MuxQuietButton}"
                                        Padding="8,8"
                                        Click="DeleteZone_Click" />
                            </Grid>

                            <Border Height="1" Background="#202833" Margin="0,18,0,16" />
                        </StackPanel>

                        <TextBlock Text="BEHAVIOR"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Margin="2,0,0,9" />

                        <CheckBox x:Name="SnapCheck"
                                  Content="Snap windows to monitors"
                                  Style="{StaticResource MuxCheckBox}"
                                  Click="BehaviorChanged_Click" />
                        <CheckBox x:Name="StartupCheck"
                                  Content="Launch at sign in"
                                  Style="{StaticResource MuxCheckBox}"
                                  Margin="0,11,0,0"
                                  Click="StartupChanged_Click" />

                        <Border Margin="0,16,0,0"
                                Background="#0B1015"
                                BorderBrush="#1F2933"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="11">
                            <StackPanel>
                                <TextBlock Text="Keyboard"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#AAB4BE" />
                                <TextBlock Text="Ctrl + Alt + M   Maximize / restore"
                                           Foreground="#64717D" FontSize="9" Margin="0,6,0,0" />
                                <TextBlock Text="Ctrl + Alt + F   MUX Fullscreen"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                                <TextBlock Text="Ctrl + Alt + B   Black bars / Stream Deck"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                                <TextBlock Text="Ctrl + Alt + ←   Previous monitor"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                                <TextBlock Text="Ctrl + Alt + →   Next monitor"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                                <TextBlock Text="Ctrl + Alt + E   Edit layout"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                                <TextBlock Text="Ctrl + Alt + A   Auto Arrange"
                                           Foreground="#64717D" FontSize="9" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
